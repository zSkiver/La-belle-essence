# ---------------------------------------------------------------------------
# La Belle Essence RV — variáveis de ambiente
# Copie este arquivo para `.env.local` e preencha os valores.
# ---------------------------------------------------------------------------

# URL pública do site (usada em canonical, Open Graph, sitemap e robots).
NEXT_PUBLIC_SITE_URL=https://labelleessencerv.com.br

# ---------------------------------------------------------------------------
# Supabase
# Painel do Supabase > Project Settings > API
#
# Sem estas variáveis o site continua funcionando: o catálogo passa a ler os
# dados de demonstração locais (src/data/seed-products.ts) e o painel /admin
# exibe um aviso de configuração pendente.
# ---------------------------------------------------------------------------

# URL do projeto (ex.: https://xxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave publishable / anon. Pode ser exposta no navegador — é protegida por RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave service role. NUNCA prefixe com NEXT_PUBLIC_ e nunca use em componentes
# de cliente. Usada apenas no servidor para registrar cliques de WhatsApp de
# forma anônima. Se ficar vazia, o registro de cliques é feito com a chave anon
# através da policy de inserção pública.
SUPABASE_SERVICE_ROLE_KEY=

# Nome do bucket de imagens de produto no Supabase Storage.
NEXT_PUBLIC_SUPABASE_PRODUCT_BUCKET=product-images

# ---------------------------------------------------------------------------
# Analytics (opcional)
# Enquanto vazias, nenhum script de terceiros é carregado e nenhum banner de
# cookies é exibido.
# ---------------------------------------------------------------------------

# ID de medição do Google Analytics 4 (ex.: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ID do Meta Pixel (ex.: 123456789012345)
NEXT_PUBLIC_META_PIXEL_ID=
